# Required. Free key, no card: https://console.groq.com/keys
GROQ_API_KEY=

# Required. Supabase project URL and publishable (anon) key.
# The Vercel Supabase integration sets these automatically.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Vercel only: secret Vercel Cron sends to /api/cron/daily (any long random string).
# CRON_SECRET=

# Optional. Groq models in priority order; later ones are fallbacks.
# AI_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b
