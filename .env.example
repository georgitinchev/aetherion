# Required. Free key, no card: https://console.groq.com/keys
GROQ_API_KEY=

# Required. Supabase project URL and publishable (anon) key.
# The Vercel Supabase integration sets these automatically.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

